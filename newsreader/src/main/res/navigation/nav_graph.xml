<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/nav_graph"
  app:startDestination="@id/home">

  <fragment
    android:id="@+id/home"
    android:name="com.example.newsreader.HomeFragment"
    android:label="@string/tab_home">
    <action
      android:id="@+id/action_home_to_detail"
      app:destination="@id/articleDetail" />
  </fragment>

  <fragment
    android:id="@+id/articleDetail"
    android:name="com.example.newsreader.ArticleDetailFragment">
    <argument
      android:name="articleId"
      android:defaultValue="-1"
      app:argType="integer" />
  </fragment>

  <fragment
    android:id="@+id/profile"
    android:name="com.example.newsreader.ProfileFragment"
    android:label="@string/tab_profile" />

  <fragment
    android:id="@+id/settings"
    android:name="com.example.newsreader.SettingsFragment"
    android:label="@string/tab_settings" />
</navigation>
